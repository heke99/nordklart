{
  "name": "nordklart",
  "version": "0.1.0",
  "private": true,
  "license": "Proprietary",
  "scripts": {
    "setup:extensions": "npx tsx scripts/generate-extension-registry.ts",
    "skills:generate": "npx tsx scripts/generate-skill-bodies.ts",
    "skills:check": "npx tsx scripts/generate-skill-bodies.ts --check",
    "faq:generate": "npx tsx scripts/generate-faq-seed.ts",
    "faq:check": "npx tsx scripts/generate-faq-seed.ts --check",
    "predev": "npm run setup:extensions && node scripts/inject-public-branding.mjs",
    "dev": "next dev",
    "prebuild": "npm run setup:extensions && node scripts/inject-public-branding.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "lint": "eslint",
    "check:guards": "node scripts/checks/no-new-antipatterns.mjs && node scripts/checks/migration-integrity.mjs && node scripts/checks/migration-redefinition.mjs && node scripts/checks/financial-hardening-contract.mjs && node scripts/checks/service-role-surface.mjs && node scripts/checks/platform-role-revocation.mjs && node scripts/checks/internal-links.mjs && node scripts/checks/env-example.mjs",
    "check:lint": "node scripts/checks/no-new-lint-errors.mjs",
    "test": "vitest run --project unit",
    "test:pg": "VITEST_PG_REAL=1 vitest run --project pg-real",
    "test:pg:bootstrap": "bash scripts/pg-test-db.sh",
    "db:migrate": "node scripts/supabase-migrate.cjs up supabase/migrations",
    "db:migrate:status": "node scripts/supabase-migrate.cjs status supabase/migrations",
    "db:migrate:list": "node scripts/supabase-migrate.cjs list supabase/migrations",
    "db:migrate:plan-after": "node scripts/supabase-migrate.cjs plan-after supabase/migrations",
    "db:migrate:mark-through": "node scripts/supabase-migrate.cjs mark-through supabase/migrations",
    "db:ledger:reconcile": "node scripts/reconcile-migration-ledger.mjs",
    "db:ledger:reconcile:apply": "node scripts/reconcile-migration-ledger.mjs --apply",
    "check:feature-policy": "npx tsx scripts/check-feature-policy-coverage.ts",
    "nordklart:platform-accounting-regression": "node scripts/nordklart-platform-accounting-regression.cjs",
    "check:migrations": "node scripts/checks/migration-integrity.mjs",
    "check:migrations:db": "node scripts/checks/migration-integrity.mjs --db",
    "check:financial-hardening": "node scripts/checks/financial-hardening-contract.mjs",
    "check:skill-provenance": "node scripts/checks/skill-provenance.mjs",
    "verify:fast": "npm run typecheck && npm run check:lint && npm run check:guards && npm run check:feature-policy && npm run skills:check && npm run check:skill-provenance && npm test",
    "verify:db": "npm run check:migrations:db && npm run test:pg",
    "verify:release": "npm run verify:fast && npm run build && npm run verify:db",
    "check:redefinition": "node scripts/checks/migration-redefinition.mjs",
    "test:pg:reset": "bash scripts/pg-test-db.sh --reset",
    "check:links": "node scripts/checks/internal-links.mjs",
    "check:env-example": "node scripts/checks/env-example.mjs"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.29.1",
    "@aws-sdk/client-s3": "^3.1069.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.93.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/qrcode": "^1.5.6",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.29.2",
    "fuse.js": "^7.1.0",
    "ics": "^3.8.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "mailparser": "^3.9.8",
    "next": "16.2.9",
    "next-intl": "^4.12.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^5.8.8",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "svix": "^1.85.0",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7",
    "write-excel-file": "^2.3.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "description": "Nordklart — svensk bokföring, bokslut och byråplattform.",
  "overrides": {
    "next": "16.2.9",
    "postcss": "^8.5.10"
  }
}
