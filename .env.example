# Nordklart — environment variables
#
# Copy to `.env.local` (Next.js dev) or supply through your platform's secret
# store. Never commit a filled-in copy: several of these are credentials whose
# rotation would orphan encrypted data (see the notes on the *_ENCRYPTION_KEY
# and BANKID_HASH_SECRET entries).
#
# Completeness is enforced by `node scripts/checks/env-example.mjs`, which fails
# when application code reads a variable this file does not mention. Values and
# defaults are NOT checked — the code is the authority on those.
#
# Legend:  [required]  the app will not start or will fail closed without it
#          [hosted]    set on the hosted deployment
#          [extension] only when the matching extension is enabled in
#                      extensions.config.json
#          [optional]  has a working default

# ─── Core: Supabase and the app itself ───────────────────────────────────────
# [required] All five are validated at container start by docker-entrypoint.sh.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
# [required] Shared secret for the cron endpoints; compared in constant time.
CRON_SECRET=

# [optional] Server-side absolute URL when it differs from the public one
# (internal ingress, preview aliases). Falls back to NEXT_PUBLIC_APP_URL.
APP_URL=

# ─── Deployment shape ────────────────────────────────────────────────────────
# [hosted] `true` disables BankID and never enforces TOTP MFA.
NEXT_PUBLIC_SELF_HOSTED=
# [hosted] `true` makes middleware redirect to /mfa/enroll or /mfa/verify until
# the session reaches AAL2.
NEXT_PUBLIC_REQUIRE_MFA=
# [optional] Serve a maintenance page instead of the app.
MAINTENANCE_MODE=
MAINTENANCE_MESSAGE=
# [optional] White-label overrides. See WHITELABEL.md; the NEXT_PUBLIC_ ones are
# inlined at build time and rewritten in .next/static by docker-entrypoint.sh.
NEXT_PUBLIC_BRANDING_APP_NAME=
NEXT_PUBLIC_BRANDING_APP_DESCRIPTION=
NEXT_PUBLIC_BRANDING_HIDDEN_NAV=
NEXT_PUBLIC_BRANDING_NAV_DENSITY=
NEXT_PUBLIC_BRANDING_LOGO_PATH=
NEXT_PUBLIC_BRANDING_FAVICON_PATH=
NEXT_PUBLIC_BRANDING_APPLE_ICON_PATH=
NEXT_PUBLIC_BRANDING_PWA_ICON_BASE=
NEXT_PUBLIC_BRANDING_THEME_COLOR=
NEXT_PUBLIC_BRANDING_MANIFEST_THEME_COLOR=
NEXT_PUBLIC_BRANDING_MANIFEST_BG_COLOR=
NEXT_PUBLIC_BRANDING_AUTH_EMAIL_FROM=
# [optional] Contact identities shown in legal and security pages.
BRANDING_LEGAL_ENTITY=
BRANDING_SUPPORT_EMAIL=
BRANDING_PRIVACY_EMAIL=
BRANDING_SECURITY_EMAIL=

# ─── Rate limiting ───────────────────────────────────────────────────────────
# [optional] Upstash powers the sliding-window limiter. Without it the shared
# limiter no-ops; endpoints that must be limited regardless fall back to a
# Postgres counter (lib/auth/rate-limit-durable.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── BankID (via the TIC Identity extension) ─────────────────────────────────
# [hosted] Master switch. Off means no BankID login, linking or consent.
NEXT_PUBLIC_BANKID_ENABLED=
# [extension] TIC Identity credentials.
TIC_IDENTITY_API_KEY=
TIC_IDENTITY_API_URL=
TIC_API_PROXY_URL=
# [required with BankID] AES-256-GCM key (64 hex chars) for personnummer at
# rest. Rotating it makes every stored identity undecryptable.
BANKID_ENCRYPTION_KEY=
# [required with BankID] HMAC key for personnummer lookup hashes. Rotating it
# silently orphans every bankid_identities row — rotate only with a re-hash.
BANKID_HASH_SECRET=
# [optional] `test` marks sessions as non-production in bankid_sessions.
BANKID_PROVIDER_MODE=
# [optional] Explicit escape hatch letting a hosted staging deployment use the
# mock provider. Never set this in production.
BANKID_ALLOW_MOCK=
# [optional] Encryption key for personnummer stored outside the BankID flow
# (customers, employees). Falls back to BANKID_ENCRYPTION_KEY.
PERSONNUMMER_ENCRYPTION_KEY=

# ─── Skatteverket ────────────────────────────────────────────────────────────
# Two independent tracks. The per-user BankID track (SKATTEVERKET_OAUTH2_*) is
# what the product uses today; the systemorganisation track (SKV_*) needs an
# organisation certificate and Skatteverket's approval, and refuses to make a
# token call until every variable below is present.
#
# [extension] Per-user OAuth track.
SKATTEVERKET_ENABLED=
SKATTEVERKET_OAUTH2_CLIENT_ID=
SKATTEVERKET_OAUTH2_CLIENT_SECRET=
SKATTEVERKET_OAUTH_BASE_URL=
SKATTEVERKET_APIGW_CLIENT_ID=
SKATTEVERKET_APIGW_CLIENT_SECRET=
SKATTEVERKET_API_BASE_URL=
SKATTEVERKET_AGD_INLAMNING_API_BASE_URL=
SKATTEVERKET_AGD_PERIOD_API_BASE_URL=
SKATTEVERKET_SKATTEKONTO_API_BASE_URL=
SKATTEVERKET_INK1_API_BASE_URL=
SKATTEVERKET_INKFORETAG_API_BASE_URL=
# [required with Skatteverket] Encrypts the stored OAuth tokens.
SKATTEVERKET_TOKEN_ENCRYPTION_KEY=
# [optional] Incident kill switch — every SKV call fails with one clear error.
SKATTEVERKET_DISABLED=
# [required in production] `test` or `prod`. Production refuses to run without
# an explicit value.
SKATTEVERKET_ENV=
#
# [extension] Systemorganisation track. getSkvSysorgAccessToken() refuses to
# call Skatteverket until the nine required ones are all set; the readiness
# panel reports the same predicate.
SKV_SYSORG_ENABLED=
SKV_ENV=
SKV_OAUTH_CLIENT_ID=
SKV_OAUTH_CLIENT_SECRET=
SKV_APIGW_CLIENT_ID=
SKV_APIGW_CLIENT_SECRET=
SKV_ORG_CERT_P12_BASE64=
SKV_ORG_CERT_PIN=
SKV_FILFRAMSTALLARE_ORGNR=
SKV_FILFRAMSTALLARE_NAME=
SKV_FILFRAMSTALLARE_CONTACT_EMAIL=
# [optional] Filframställare detail and endpoint overrides.
SKV_FILFRAMSTALLARE_ID=
SKV_FILFRAMSTALLARE_CONTACT_NAME=
SKV_FILFRAMSTALLARE_CONTACT_PHONE=
SKV_SYSORG_TOKEN_URL=
SKV_SCOPES=
SKV_REQUEST_TIMEOUT_MS=
SKV_MOMS_API_BASE_URL=
SKV_AGD_INLAMNING_API_BASE_URL=
SKV_AGD_PERIOD_API_BASE_URL=
SKV_INK1_API_BASE_URL=
SKV_INKFORETAG_API_BASE_URL=
#
# Legacy aliases, still accepted by firstEnv() so an older deployment keeps
# working. Prefer the canonical names above; do not set both.
# SKV_ENABLED=
# SKATTEVERKET_SYSORG_TOKEN_URL=
# SKATTEVERKET_SYSORG_SCOPES=
# SKATTEVERKET_REQUEST_TIMEOUT_MS=
# SKATTEVERKET_ORG_CERT_P12_BASE64=
# SKATTEVERKET_ORG_CERT_PIN=
# SKATTEVERKET_FILFRAMSTALLARE_ORGNR=
# SKATTEVERKET_FILFRAMSTALLARE_NAME=
# SKATTEVERKET_FILFRAMSTALLARE_ID=
# SKATTEVERKET_FILFRAMSTALLARE_CONTACT_EMAIL=
# SKATTEVERKET_FILFRAMSTALLARE_CONTACT_NAME=
# SKATTEVERKET_FILFRAMSTALLARE_CONTACT_PHONE=

# ─── Bolagsverket ────────────────────────────────────────────────────────────
# [extension] `oauth` or `mtls` decides which credential set below is used.
BOLAGSVERKET_AUTH_METHOD=
BOLAGSVERKET_ENV=
BOLAGSVERKET_ENVIRONMENT=
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
BOLAGSVERKET_TOKEN_URL=
BOLAGSVERKET_API_BASE_URL=
BOLAGSVERKET_CLIENT_CERT=
BOLAGSVERKET_CLIENT_KEY=
BOLAGSVERKET_CA=
BOLAGSVERKET_TIMEOUT_MS=

# ─── Enable Banking (PSD2) ───────────────────────────────────────────────────
# [extension] Sandbox pair, plus a separate production pair so a deployment
# cannot reach production banks with sandbox keys by accident.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_API_URL=
ENABLE_BANKING_APP_ID_PRODUCTION=
ENABLE_BANKING_PRIVATE_KEY_PRODUCTION=
ENABLE_BANKING_API_URL_PRODUCTION=
ENABLE_BANKING_PSU_TYPE=

# ─── Accounting-provider imports ─────────────────────────────────────────────
# [extension] OAuth apps for the migration/import connectors.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_REDIRECT_URI=
VISMA_CLIENT_ID=
VISMA_CLIENT_SECRET=
VISMA_REDIRECT_URI=
BJORN_LUNDEN_CLIENT_ID=
BJORN_LUNDEN_CLIENT_SECRET=
BRIOX_CLIENT_ID=
GNUBOK_WEBHOOK_SECRET=
# [required with any provider] Encrypts stored provider tokens.
PROVIDER_TOKEN_ENCRYPTION_KEY=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# [extension]
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_INBOUND_DOMAIN=
RESEND_INBOUND_WEBHOOK_SECRET=
SUPPORT_RECIPIENT_EMAIL=

# ─── Document extraction (OCR) ───────────────────────────────────────────────
# [extension] `off`, `local` or `service`.
OCR_MODE=
OCR_SERVICE_URL=
OCR_SERVICE_HMAC_SECRET=
OCR_DEFAULT_LANG=
DOCUMENT_VERIFY_BATCH_SIZE=

# ─── AI providers ────────────────────────────────────────────────────────────
# [optional] Anthropic direct, or through AWS Bedrock. Bedrock needs the AWS
# credentials below and the two model ids.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
BEDROCK_OPUS_MODEL_ID=
BEDROCK_SONNET_MODEL_ID=

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# [hosted]
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
STRIPE_TAX_ENABLED=
STRIPE_TAX_MODE=

# ─── E-invoicing and financing ───────────────────────────────────────────────
# [extension]
PEPPOL_PROVIDER=
PEPPOL_INBOUND_SECRET=
INVOICE_FINANCING_PROVIDER=
INVOICE_FINANCING_WEBHOOK_SECRET=

# ─── Google Drive (cloud backup) ─────────────────────────────────────────────
# [extension]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Web push ────────────────────────────────────────────────────────────────
# [extension] Generate with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ─── Miscellaneous ───────────────────────────────────────────────────────────
# [optional] Bot/abuse signal on the public signup form.
NEXT_PUBLIC_RECAPT_PUBLIC_KEY=
# [optional] Outbound automation webhook target.
ACTIVEPIECES_URL=
# [optional] Error reporting.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
